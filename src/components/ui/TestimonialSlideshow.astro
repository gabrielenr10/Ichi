---
import TestimonialCard from "./TestimonialCard.astro"
import type { Testimonial } from "../../types/testimonial"

interface Props {
    testimonials: Testimonial[]
}

const { testimonials } = Astro.props
---

<div class="testimonial-slideshow mx-auto">
    <div class="testimonial-viewport overflow-hidden">
        <div class="testimonial-track relative flex gap-6 transition-transform duration-500 ease-out">
            {
                testimonials.map((testimonial) => (
                    <div class="testimonial-slide shrink-0 w-[85%] sm:w-[70%] lg:w-[55%]">
                        <TestimonialCard
                            date={testimonial.date}
                            title={testimonial.title}
                            description={testimonial.description}
                            imagePath={testimonial.imagePath}
                        />
                    </div>
                ))
            }
        </div>
    </div>

    <div class="testimonial-controls flex items-center justify-center gap-4 mt-8">
        <button
            type="button"
            class="testimonial-prev text-primary disabled:opacity-40 disabled:cursor-not-allowed"
            aria-label="Anterior"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M15 18l-6-6 6-6"></path>
            </svg>
        </button>
        <div class="testimonial-dots flex gap-2" role="tablist" aria-label="Seleccionar testimonio">
            {
                testimonials.map((_, i) => (
                    <button
                        type="button"
                        class="testimonial-dot w-3 h-3 rounded-full bg-gray-300 transition-all duration-300 aria-selected:bg-primary aria-selected:scale-125"
                        role="tab"
                        aria-selected={i === 0}
                        aria-label={`Ir al testimonio ${i + 1}`}
                    />
                ))
            }
        </div>
        <button
            type="button"
            class="testimonial-next text-primary disabled:opacity-40 disabled:cursor-not-allowed"
            aria-label="Siguiente"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M9 18l6-6-6-6"></path>
            </svg>
        </button>
    </div>
</div>

<script>
    function initTestimonialSlideshow(container: HTMLElement) {
        const viewport = container.querySelector(".testimonial-viewport") as HTMLElement
        const track = container.querySelector(".testimonial-track") as HTMLElement
        const slides = Array.from(container.querySelectorAll(".testimonial-slide")) as HTMLElement[]
        const prevBtn = container.querySelector(".testimonial-prev") as HTMLButtonElement
        const nextBtn = container.querySelector(".testimonial-next") as HTMLButtonElement
        const dotsContainer = container.querySelector(".testimonial-dots") as HTMLElement
        const controlsEl = container.querySelector(".testimonial-controls") as HTMLElement

        if (!viewport || !track || slides.length === 0) return

        let current = 0
        const count = slides.length

        if (count <= 1 && controlsEl) {
            controlsEl.classList.add("hidden")
        }

        function goTo(index: number) {
            current = Math.max(0, Math.min(index, count - 1))
            const slide = slides[current]
            const viewportWidth = viewport.offsetWidth
            const slideLeft = slide.offsetLeft
            const slideWidth = slide.offsetWidth
            const offset = slideLeft - (viewportWidth - slideWidth) / 2
            track.style.transform = `translateX(${-offset}px)`
            updateControls()
        }

        function updateControls() {
            prevBtn?.toggleAttribute("disabled", current === 0)
            nextBtn?.toggleAttribute("disabled", current === count - 1)
            dotsContainer?.querySelectorAll(".testimonial-dot").forEach((dot, i) => {
                dot.setAttribute("aria-selected", String(i === current))
            })
        }

        prevBtn?.addEventListener("click", () => goTo(current - 1))
        nextBtn?.addEventListener("click", () => goTo(current + 1))
        dotsContainer?.querySelectorAll(".testimonial-dot").forEach((dot, i) => {
            dot.addEventListener("click", () => goTo(i))
        })

        goTo(0)

        let resizeTimeout: ReturnType<typeof setTimeout>
        window.addEventListener("resize", () => {
            clearTimeout(resizeTimeout)
            resizeTimeout = setTimeout(() => goTo(current), 150)
        })
    }

    document.querySelectorAll(".testimonial-slideshow").forEach((el) => initTestimonialSlideshow(el as HTMLElement))
</script>
