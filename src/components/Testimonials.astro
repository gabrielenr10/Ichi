---
import Button from "./ui/Button.astro"
import TestimonialSlideshow from "./ui/TestimonialSlideshow.astro"
import type { Testimonial } from "../types/testimonial"

const whatsappMessage = "Hola, quiero agendar una cita para evaluar mi caso y empezar con un plan personalizado."
const whatsappHref = `https://wa.me/+34647559174/?text=${encodeURIComponent(whatsappMessage)}`

const imageModules = import.meta.glob<{ default: ImageMetadata }>("../assets/testimonials/*.{jpeg,jpg,png,webp}", {
    eager: true,
})

const imagesByName = Object.fromEntries(
    Object.entries(imageModules).map(([path, mod]) => {
        const fileName = path.split("/").pop() ?? path
        return [fileName, mod.default]
    })
)

const testimonials: Testimonial[] = [
    {
        title: "Laura",
        description:
            "Parece que no, porque te ves a diario y aún ves que hay mucho trabajo, pero luego ves estas fotos y... madre mía, en la de frente se ve como más definido, la de lateral mucha menos barriga y la de espaldas como el culo más arriba 🫣🫠🫠🫠. Estoy súper cómoda, ha sido sencillo y guay cumplirlo la verdad, así da gusto! Mil gracias Ichi",
        imageFileName: "testimonio_Laura.png",
    },
    {
        title: "Zai",
        description:
            "Buenos días a tope que estoy con mi serie de hoy me está flipando todo. Solo quería hacerte saber que estoy disfrutando un montón. Por supuesto que hemos cumplido 💪🏼 y así seguiremos🔥, me siento genial!!! y cada día con ganas de massss!! Graciassss por todo 🫶🏼",
        imageFileName: "testimonio_Zai.png",
    },
    {
        title: "Ana",
        description:
            "He bajado en 10 días 10kg: 7 cm menos de pecho, 10 cm de cadera, 17 cm de cintura y 2 cm de muslo. No puedo estar más feliz 💃 Me daba un poco cosa ir al gym o hacer dietas, con lo que me gusta comer, pensaba en lo aburrido que suponía que era. Con 53 años, la premenopausia, pensaba que me tocaba estar así. Ojalá y te descubrieran muchas más personas que no se atreven, porque si supieran lo bien que se van a sentir por dentro y por fuera, es una forma distinta de ver la vida, ¡te sientes tan bien!",
        imageFileName: "testimonio_Ana.png",
    },
    {
        title: "Ale",
        description:
            "La verdad es que viéndolo así me impresiona bastante, no era consciente de este cambio, qué alegría!!! Estoy súper contenta de haber encontrado un buen equilibrio en un proceso tan complicado mentalmente, me dices en septiembre que voy a estar así (física y mentalmente) en marzo, y no me lo creo.",
        imageFileName: "testimonio_Ale.png",
    },
    {
        title: "Sandra",
        description:
            "Gracias Icíar! Estoy encantada contigo, tu método y el proceso. Lo estoy disfrutando mucho y viendo muchos cambios en mi, a nivel físico y mental. Gracias!",
        imageFileName: "testimonio_Sandra.png",
    },
].map((testimonial) => ({
    ...testimonial,
    imagePath: imagesByName[testimonial.imageFileName],
}))
---

<section id="testimonios" class="py-27 px-8 bg-contrast-light text-center">
    <div class="max-w-6xl mx-auto">
        <h1 class="mb-6">¿Qué opinan nuestros clientes?</h1>
        <p class="text-2xl mb-12">
            Todos los planes pueden contratarse a <span class="font-bold">3, 6 o 12 meses</span>. Empezamos con
            diagnóstico y entramos en el nivel que encaje con tu situación.
        </p>
    </div>
    <TestimonialSlideshow testimonials={testimonials} />
    <Button class="mx-auto mt-12">
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer">Agenda una cita</a>
    </Button>
</section>
