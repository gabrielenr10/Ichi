---
import Button from "./ui/Button.astro"
import Slideshow from "./ui/Slideshow.astro"

const imageModules = import.meta.glob<{ default: ImageMetadata }>("../assets/results/*.{jpeg,jpg,png}", { eager: true })

const images: ImageMetadata[] = Object.entries(imageModules)
    .sort(([pathA], [pathB]) => {
        const numA = parseInt(pathA.match(/result_(\d+)/)?.[1] ?? "999", 10)
        const numB = parseInt(pathB.match(/result_(\d+)/)?.[1] ?? "999", 10)
        return numA - numB
    })
    .map(([, mod]) => mod.default)
---

<section id="results" class="py-27 px-8 bg-contrast-light text-center">
    <div class="max-w-6xl mx-auto">
        <h1 class="mb-6">Resultados de nuestros clientes</h1>
        <p class="text-2xl mb-12">
            Todos los planes pueden contratarse a <span class="font-bold">3, 6 o 12 meses</span>. Empezamos con
            diagnóstico y entramos en el nivel que encaje con tu situación.
        </p>
    </div>
    <Slideshow images={images} />
    <Button class="mx-auto mt-12">Agenda una cita</Button>
</section>
